# Public hostname Caddy will obtain an HTTPS certificate for.
# A free option is DuckDNS: create a subdomain and point it at your VM's IP.
DOMAIN=yourname.duckdns.org

# Comma-separated YouTube player clients yt-dlp should try. On datacenter IPs
# these often dodge 403 / PoToken prompts. Leave default unless you hit issues.
YT2P_PLAYER_CLIENTS=ios,web_safari

# Max simultaneous audio streams (protects the VM / bandwidth).
YT2P_MAX_STREAMS=20

# Refresh yt-dlp on each container start (recommended; YouTube changes a lot).
YT2P_UPDATE_YTDLP=1
